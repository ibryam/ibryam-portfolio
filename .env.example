# OpenAI — gpt-4o-mini (main agent, cheap + reliable)
OPENAI_API_KEY=

# Google AI — gemini-2.0-flash (evaluator primary, 15 RPM free tier)
GOOGLE_API_KEY=

# Groq — llama-3.1-8b-instant (evaluator fallback if Gemini fails)
GROQ_API_KEY=

# Telegram — agentic notifications for unknown questions & recruiter contact
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Set to your HuggingFace Space URL once deployed (used in frontend BACKEND_URL)
BACKEND_URL=http://localhost:8000
